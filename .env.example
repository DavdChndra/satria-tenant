# ============================================================
# SATRIA 2026 — Konfigurasi Environment
# ------------------------------------------------------------
# Salin file ini menjadi .env lalu isi nilainya:
#   Windows : copy .env.example .env
#   Linux   : cp .env.example .env
#
# File .env berisi kredensial rahasia dan sudah masuk .gitignore.
# JANGAN commit .env ke git dan jangan bagikan isinya.
# ============================================================


# --- Kunci sesi Flask -----------------------------------------------
# Dipakai untuk menandatangani cookie login admin.
# WAJIB diganti dengan string acak sebelum publish ke internet.
# Cara membuat nilai acak yang kuat:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-yang-panjang


# --- Kredensial Midtrans --------------------------------------------
# Ambil dari dashboard.midtrans.com > Settings > Access Keys
#
# Mode SANDBOX (untuk testing, uang tidak benar-benar terpotong):
#   key berawalan SB-Mid-server-... dan SB-Mid-client-...
#   set MIDTRANS_IS_PRODUCTION=false
#
# Mode PRODUCTION (transaksi asli):
#   key berawalan Mid-server-... dan Mid-client-...
#   set MIDTRANS_IS_PRODUCTION=true
#
# Pastikan server key dan client key berasal dari mode yang SAMA,
# dan cocok dengan nilai MIDTRANS_IS_PRODUCTION di bawah.

# Server Key — dipakai backend untuk membuat transaksi & verifikasi
# signature webhook. Bersifat RAHASIA, tidak boleh bocor ke browser.
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx

# Client Key — ditanam di halaman web untuk memuat Snap.js.
# Tidak rahasia (memang terlihat di browser), tapi tetap harus benar.
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx

# false = sandbox/testing | true = production/transaksi asli
# Nilai ini juga menentukan Snap.js mana yang dimuat di halaman depan.
MIDTRANS_IS_PRODUCTION=false


# --- Pengiriman email (opsional) -------------------------------------
# Dipakai untuk mengirim email otomatis ke pendaftar:
#   1. saat pendaftaran dibuat  -> berisi nomor & link status
#   2. saat pembayaran lunas    -> berisi bukti pembayaran
#
# Bila SMTP_USER/SMTP_PASS dikosongkan, aplikasi tetap berjalan normal
# tanpa mengirim email sama sekali.
#
# Cara memakai Gmail:
#   1. Aktifkan verifikasi 2 langkah di akun Google panitia
#   2. Buka https://myaccount.google.com/apppasswords
#   3. Buat "App password" baru, salin 16 huruf yang muncul ke SMTP_PASS
#      (pakai App Password, BUKAN password Gmail biasa)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=panitia@gmail.com
SMTP_PASS=xxxxxxxxxxxxxxxx
SMTP_FROM_NAME=Panitia SATRIA 2026
